<style>
:root{
  --bg:#232323; --bg-2:#1F1F1F; --text:#FFFFFF; --text-2:#B5B8BD;
  --cta:#8BC34A; --cta-hover:#6FAE3A; --cta-dark:#111;
  --tg:#3B82F6; --wa:#25D366; --ig:#E1306C;
  --orange:#ff7a00; /* яркий оранжевый баннера */
  --tap-h:52px; --radius:14px; --maxw:1140px; --shadow:0 10px 24px rgba(0,0,0,.35);
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0; font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,"Noto Sans";
  background:var(--bg); color:var(--text); line-height:1.5;
  -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  padding-bottom:calc(100px + env(safe-area-inset-bottom));
}
a{color:inherit; text-decoration:none}
.wrap{max-width:var(--maxw); margin:0 auto; padding:0 16px}

/* Header + nav */
header{position:sticky; top:0; z-index:30; background:rgba(35,35,35,.92); backdrop-filter:blur(8px);
  border-bottom:1px solid rgba(255,255,255,.06)}
.header-row{display:flex; align-items:center; justify-content:space-between; height:56px}
.brand{display:flex; gap:10px; align-items:center; font-weight:700}
.logo{width:22px; height:22px; border:3px solid var(--cta); transform:rotate(13deg) skewX(-6deg);
  border-left-color:transparent; border-bottom-color:transparent; border-radius:3px}
.brand-name{font-size:18px}
.nav{display:flex; gap:12px; align-items:center}
.nav a{padding:8px 10px; border-radius:10px; color:#ddd; font-weight:600}
.nav a:hover{background:rgba(255,255,255,.08); color:#fff}
.burger{display:none}

@media (max-width:960px){
  .actions{display:none}
  .burger{display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:10px;
    border:1px solid rgba(255,255,255,.12); background:transparent; color:#fff; cursor:pointer}
  .nav{display:none}
  .nav.open{display:flex; position:fixed; top:56px; left:0; right:0; background:#151515; padding:12px 16px;
    gap:8px; flex-wrap:wrap; border-bottom:1px solid rgba(255,255,255,.08)}
}

/* Buttons */
.btn{display:inline-flex; align-items:center; justify-content:center; gap:10px;
  height:var(--tap-h); padding:0 18px; border:0; cursor:pointer; border-radius:var(--radius);
  font-weight:700; font-size:16px; transition:.18s; white-space:nowrap}
.btn-ghost{background:transparent; color:var(--text); border:1px solid rgba(255,255,255,.16)}
.btn-cta{background:var(--cta); color:var(--cta-dark)}
.btn-cta:hover{background:var(--cta-hover)}
.btn-wa{background:var(--wa); color:#fff}
.btn-tg{background:var(--tg); color:#fff}
.btn-ig{background:var(--ig); color:#fff}
.btn-block{width:100%}
.small{height:40px; font-size:14px}

/* Hero */
.hero{padding:18px 0 8px;}
h1{font-size:28px; line-height:1.25; margin:6px 0 6px}
.sub{color:var(--text-2); margin:0 0 6px}
.lic{color:#9ad3ff; font-weight:700; margin:0 0 10px}
.cta-row{display:grid; grid-template-columns:1fr 1fr; gap:8px; margin:10px 0 16px}
@media (min-width:720px){ .cta-row{grid-template-columns:1.2fr 1fr 1fr 1.2fr} }

/* Panel + (НЕ ТРОГАЕМ) калькулятор */
.panel{background:var(--bg-2); border:1px solid rgba(255,255,255,.08); border-radius:16px; padding:16px; box-shadow:var(--shadow)}
.calc-grid{display:grid; grid-template-columns:1fr; gap:12px}
.field{display:flex; flex-direction:column; gap:8px}
.field label{color:var(--text-2); font-size:14px}
.input{
  display:flex; align-items:center; gap:8px; height:56px; border-radius:12px;
  background:#141414; border:1px solid rgba(255,255,255,.16); padding:0 10px; font-size:18px;
}
.input input{flex:1 1 auto; min-width:0; background:transparent; border:0; outline:0; color:var(--text); font-size:18px}
.select{
  flex:0 0 104px; width:104px; appearance:none; background:#1C1C1C; border:0; color:#fff;
  height:44px; padding:0 12px; border-radius:10px; font-size:16px;
}

/* Баннер фиксации — (оставляем как был, стили совпадают) */
.hold-banner{
  margin-top:12px; border:2px solid var(--orange); border-radius:16px;
  padding:12px 14px; background:linear-gradient(180deg, rgba(255,122,0,.22), rgba(255,122,0,.14));
  box-shadow:0 10px 24px rgba(255,122,0,.35), inset 0 0 0 1px rgba(255,255,255,.05);
  display:flex; flex-direction:column; gap:10px
}
.hold-row{display:flex; align-items:center; gap:10px; font-weight:800}
.hold-row .dot{width:12px; height:12px; border-radius:50%; background:var(--orange); box-shadow:0 0 0 3px rgba(255,122,0,.28), 0 0 14px rgba(255,122,0,.95)}
.hold-actions{display:flex; gap:8px; flex-wrap:wrap}
.btn-badge{
  height:40px; padding:0 14px; border-radius:12px; border:1px solid rgba(255,122,0,.7);
  background:rgba(255,122,0,.18); color:#fff; font-weight:800; cursor:default
}
.hidden{display:none}

/* Две CTA под расчётом (оставляем как было) */
.two-ctas{display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px}
@media (max-width:360px){ .two-ctas{grid-template-columns:1fr} }

/* ===== Раздел КУРСОВ ===== */
.section{padding:20px 0}
.section h2{margin:0 0 12px; font-size:24px}
.rates-toolbar{display:flex; gap:8px; align-items:center; flex-wrap:wrap; justify-content:space-between}
.pills{display:flex; gap:8px; flex-wrap:wrap}
.pill{height:40px; padding:0 14px; border-radius:999px; border:1px solid rgba(255,255,255,.16);
  background:#151515; color:#fff; font-weight:700; cursor:pointer}
.pill.active{background:var(--cta); color:var(--cta-dark); border-color:transparent}
.updated{color:var(--text-2); font-size:13px}
.rates{margin-top:10px; border:1px solid rgba(255,255,255,.08); border-radius:12px; overflow:hidden}
.rates table{width:100%; border-collapse:collapse; font-size:16px}
.rates th, .rates td{padding:12px 10px; border-bottom:1px solid rgba(255,255,255,.06)}
.rates th{background:#141414; color:#bbb; text-align:left; font-weight:600}
.rates tr:hover{background:#101010; cursor:pointer}
.show-more{margin-top:10px}

/* Блок доверия + карта */
.trust{display:grid; gap:16px; grid-template-columns:1.2fr 1fr; align-items:stretch}
.trust .list{display:grid; gap:10px}
.trust .item{display:flex; gap:10px; align-items:center; background:#141414; border:1px solid rgba(255,255,255,.08);
  padding:12px; border-radius:12px}
.i-check{flex:0 0 22px; height:22px; border-radius:6px; background:var(--cta);
  display:inline-flex; align-items:center; justify-content:center; color:var(--cta-dark); font-weight:700; font-size:14px}
.address{color:var(--text-2); font-size:13px; margin-top:6px}
.map-btn{display:inline-flex; align-items:center; justify-content:center; height:44px; padding:0 14px; border-radius:12px;
  border:1px solid rgba(255,255,255,.14); background:#131313; color:#fff; font-weight:700; margin-top:8px}

/* Галерея */
.gallery{display:grid; grid-template-columns:1fr 1fr; gap:10px}
.gallery .ph{height:140px; background:#111; border:1px solid rgba(255,255,255,.08); border-radius:12px;
  display:flex; align-items:center; justify-content:center; color:#777}
@media (min-width:820px){ .gallery{grid-template-columns:repeat(4,1fr)} }

/* Отзывы */
.reviews{overflow:hidden; position:relative}
.track{display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; padding-bottom:4px}
.card{min-width:280px; max-width:320px; scroll-snap-align:start; background:#141414; border:1px solid rgba(255,255,255,.08);
  border-radius:14px; padding:14px}
.stars{color:#ffd166; margin-bottom:8px}

/* FAQ */
.faq details{background:#141414; border:1px solid rgba(255,255,255,.08); border-radius:12px; padding:12px 14px; margin:10px 0}
.faq summary{list-style:none; cursor:pointer; font-weight:700}
.faq summary::-webkit-details-marker{display:none}
.faq .answer{margin-top:8px; color:#dcdcdc}

/* Docs */
.docs{display:grid; grid-template-columns:1fr; gap:10px}
.doc{background:#141414; border:1px solid rgba(255,255,255,.08); border-radius:12px; padding:12px}
.doc .t{font-weight:700}
.doc .a{color:var(--text-2); font-size:13px}

/* Footer + Sticky */
footer{border-top:1px solid rgba(255,255,255,.08); margin-top:24px}
.footer-row{display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between; padding:16px 0; color:var(--text-2); font-size:13px}
.links{display:flex; gap:12px; flex-wrap:wrap}

.sticky{
  position:fixed; bottom:0; left:0; right:0; z-index:25; background:rgba(20,20,20,.96);
  backdrop-filter:blur(6px); border-top:1px solid rgba(255,255,255,.08);
