const btnCalc=document.getElementById('btnCalc');
const btnBuyWA=document.getElementById('btnBuyWA');
const btnBuyTG=document.getElementById('btnBuyTG');

const holdBanner=document.getElementById('holdBanner');
const holdLeft=document.getElementById('holdLeft');
const holdUntil=document.getElementById('holdUntil');
const holdCancel=document.getElementById('holdCancel');
const holdOrder=document.getElementById('holdOrder');
const holdSummary=document.getElementById('holdSummary');

let holdEndTs=null, holdTimer=null;
let lockedQuote=null; // {id, amount, from, to, result}

function format2(n){const v=isFinite(n)?n:0;return v.toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2});}
function compute(){const amount=parseFloat((giveEl.value||'0').replace(',','.'));const f=baseRates[fromEl.value], t=baseRates[toEl.value];if(!f||!t){getEl.value='0,00';return;}const thb=amount*f*(1-hiddenMargin);getEl.value=format2(thb/t);}
function pad(n,len){return String(n).padStart(len,'0');}
function todayStr(){const d=new Date();return d.getFullYear()+pad(d.getMonth()+1,2)+pad(d.getDate(),2);}
function nextOrderId(){const today=todayStr();const lastDate=localStorage.getItem('delta69_seq_date')||'';let seq=parseInt(localStorage.getItem('delta69_seq')||'0',10);if(lastDate!==today){seq=0;}seq++;localStorage.setItem('delta69_seq',String(seq));localStorage.setItem('delta69_seq_date',today);return `D69-${today}-${pad(seq,3)}`;}

function lockCurrentQuoteFromUI(){
  let id = lockedQuote && lockedQuote.id && holdEndTs && holdEndTs>Date.now() ? lockedQuote.id : nextOrderId();
  lockedQuote={ id, amount:(giveEl.value||'').toString().trim(), from:fromEl.value, to:toEl.value, result:(getEl.value||'').toString().trim() };
  localStorage.setItem('delta69_hold_quote', JSON.stringify(lockedQuote));
  renderHoldSummary();
}
function renderHoldSummary(){
  if(!lockedQuote){ holdOrder.textContent=''; holdSummary.textContent=''; return; }
  holdOrder.textContent=`Заявка № ${lockedQuote.id}`;
  holdSummary.textContent=`Обмен: ${lockedQuote.amount} ${lockedQuote.from} → ${lockedQuote.result} ${lockedQuote.to}.  Вы получите: ${lockedQuote.result} ${lockedQuote.to}`;
}

function buildMessage(channel){
  const now=Date.now();
  const holdActive=holdEndTs && holdEndTs>now && lockedQuote;
  const id=holdActive&&lockedQuote.id?lockedQuote.id:'без номера';
  const amount=holdActive?lockedQuote.amount:(giveEl.value||'').trim();
  const result=holdActive?lockedQuote.result:(getEl.value||'').trim();
  const from=holdActive?lockedQuote.from:fromEl.value;
  const to=holdActive?lockedQuote.to:toEl.value;
  const until=holdActive?new Date(holdEndTs).toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'}):'—';
  return `Здравствуйте! Заявка № ${id}
Обмен: ${amount} ${from} → ${result} ${to}
Курс зафиксирован до ${until}.
Готов подъехать сегодня. Спасибо!`;
}
async function openWA(){const msg=encodeURIComponent(buildMessage('wa')); window.open("https://wa.me/66961689130?text="+msg,"_blank");}
async function openTG(){
  const raw=buildMessage('tg');
  try{ await navigator.clipboard.writeText(raw); alert('Текст заявки скопирован — открываем Telegram, просто вставьте его в чат.'); }catch(e){ alert('Скопируйте текст заявки:\n\n'+raw); }
  window.open("https://t.me/Delta69_Office","_blank");
}

function startHold(minutes=10){holdEndTs=Date.now()+minutes*60*1000; localStorage.setItem('delta69_hold_until',holdEndTs); holdBanner.classList.remove('hidden'); updateHoldUI(); holdTimer&&clearInterval(holdTimer); holdTimer=setInterval(updateHoldUI,1000);}
function clearHold(){holdEndTs=null; localStorage.removeItem('delta69_hold_until'); holdBanner.classList.add('hidden'); holdTimer&&clearInterval(holdTimer); lockedQuote=null; localStorage.removeItem('delta69_hold_quote'); renderHoldSummary();}
function updateHoldUI(){if(!holdEndTs) return; const left=Math.max(0,holdEndTs-Date.now()); const m=Math.floor(left/60000), s=Math.floor((left%60000)/1000); holdLeft.textContent=`${pad(m,2)}:${pad(s,2)}`; const dt=new Date(holdEndTs); holdUntil.textContent=dt.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'}); if(left<=0){ clearHold(); alert('Время фиксации истекло. Пересчитайте курс.'); }}

holdCancel?.addEventListener('click', clearHold);
btnCalc.addEventListener('click', ()=>{ compute(); lockCurrentQuoteFromUI(); startHold(10); });
[giveEl, getEl].forEach(el=>{ el.addEventListener('keydown',e=>{ if(e.key==='Enter'){ btnCalc.click(); } }); });
btnBuyWA.addEventListener('click', ()=>{ compute(); openWA(); });
btnBuyTG.addEventListener('click', ()=>{ compute(); openTG(); });

(function restore(){
  const ts=parseInt(localStorage.getItem('delta69_hold_until')||'0',10);
  if(ts && ts>Date.now()){ holdEndTs=ts; holdBanner.classList.remove('hidden'); holdTimer=setInterval(updateHoldUI,1000); updateHoldUI(); }
  try{ const saved=localStorage.getItem('delta69_hold_quote'); if(saved){ lockedQuote=JSON.parse(saved); renderHoldSummary(); } }catch(e){ lockedQuote=null; localStorage.removeItem('delta69_hold_quote'); }
})();
compute();
/* ======= /калькулятор ======= */

/* ======= КУРСЫ: данные (пример, можно заменить на API) ======= */
const ratesBoardData=[
  {pair:"AED/THB", buy:8.377, sell:8.925},
  {pair:"USD/THB", buy:31.264, sell:32.216},
  {pair:"EUR/THB", buy:33.952, sell:34.880},
  {pair:"USD/RUB", buy:82.291, sell:86.069},
  {pair:"EUR/RUB", buy:96.472, sell:100.410},
  {pair:"THB/RUB", buy:2.434, sell:2.862},
  {pair:"RUB/THB", buy:0.35,  sell:0.41},
  {pair:"EUR/USD", buy:1.07,  sell:1.09}
];

const ratesTBody=document.querySelector('#ratesTable tbody');
const updatedEl=document.getElementById('ratesUpdated');
const pills=[...document.querySelectorAll('.pill')];
const btnMore=document.getElementById('btnMore');
let currentFilter='all', showAll=false;

function renderRates(){
  updatedEl.textContent=new Date().toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});
  ratesTBody.innerHTML='';
  const data=ratesBoardData.filter(row=>{
    if(currentFilter==='all') return true;
    const [,to]=row.pair.split('/');
    return to===currentFilter;
  });
  const limited = showAll?data:data.slice(0,6);
  limited.forEach(row=>{
    const tr=document.createElement('tr');
    tr.innerHTML=`<td>${row.pair}</td><td>${row.buy}</td><td>${row.sell}</td>`;
    tr.addEventListener('click',()=>{
      const [from,to]=row.pair.split('/');
      fromEl.value=from; toEl.value=to; compute();
      document.getElementById('calc').scrollIntoView({behavior:'smooth', block:'start'});
    });
    ratesTBody.appendChild(tr);
  });
  btnMore.textContent = showAll ? 'Скрыть' : 'Показать все валюты';
}
pills.forEach(p=>p.addEventListener('click',()=>{ pills.forEach(x=>x.classList.remove('active')); p.classList.add('active'); currentFilter=p.dataset.filter; renderRates(); }));
btnMore.addEventListener('click',()=>{ showAll=!showAll; renderRates(); });
renderRates();

/* Лёгкая авто-прокрутка отзывов */
const track=document.getElementById('reviewsTrack');
let autoScroll=setInterval(()=>{ track.scrollBy({left:320, behavior:'smooth'}); if(track.scrollLeft+track.clientWidth>=track.scrollWidth-2){ track.scrollTo({left:0,behavior:'smooth'});} },3500);
track.addEventListener('mouseenter',()=>clearInterval(autoScroll));
track.addEventListener('mouseleave',()=>autoScroll=setInterval(()=>{ track.scrollBy({left:320, behavior:'smooth'}); if(track.scrollLeft+track.clientWidth>=track.scrollWidth-2){ track.scrollTo({left:0,behavior:'smooth'});} },3500));
</script>
</body>
